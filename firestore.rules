rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidPageStatusPayload() {
      return request.resource.data.keys().hasOnly(['url', 'status', 'clearedAt', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.status is string
        && (request.resource.data.status == 'cleared' || request.resource.data.status == 'open')
        && request.resource.data.clearedAt is string
        && request.resource.data.updatedAt is string
        && (request.resource.data.status == 'cleared'
            ? request.resource.data.clearedAt.size() > 0
            : request.resource.data.clearedAt.size() == 0);
    }

    match /pageStatus/{pageId} {
      allow read: if true;
      allow create, update: if isValidPageStatusPayload();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
